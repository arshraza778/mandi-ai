# MandiMind AI Configuration
# Backend API Base URL (empty for mock mode, or your Express/FastAPI endpoint)
VITE_API_BASE_URL=""

# Enable mock API data when backend is not connected (true | false)
VITE_USE_MOCK_API="true"

# Optional Gemini API Key for client-side AI advisory (or use server proxy /api/ai)
# Note: AI Studio injects GEMINI_API_KEY into server environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application Deployment URL
APP_URL="MY_APP_URL"
